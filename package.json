{
  "name": "cityscape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "server": "node --experimental-strip-types server/index.ts",
    "server:public": "node --env-file=server/public.env --experimental-strip-types server/index.ts",
    "start:site": "next start --hostname 127.0.0.1 --port 3001",
    "test:browser": "node scripts/browser-check.mjs",
    "test:interiors": "node --experimental-strip-types scripts/interiors-check.mjs",
    "test:hud": "node scripts/hud-check.mjs",
    "test:startup": "node scripts/startup-check.mjs",
    "test:living-city": "node --experimental-strip-types scripts/living-city-check.mjs",
    "test:dead-letter": "node scripts/dead-letter-check.mjs",
    "test:rail": "node --experimental-strip-types scripts/shared-rail-check.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:shaders": "node scripts/shader-startup-check.mjs --specialized",
    "audit:motion": "node scripts/motion-capture.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "textmode.filters.js": "1.2.5",
    "textmode.js": "0.18.0",
    "textmode.synth.js": "1.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
